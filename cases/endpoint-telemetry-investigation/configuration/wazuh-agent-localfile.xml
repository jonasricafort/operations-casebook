<!--
  Excerpt from the Wazuh Windows agent configuration (ossec.conf) on client01.
  These two event-channel blocks were added for this case. The rest of the
  file was the agent's default configuration and is not reproduced here.
-->
<ossec_config>
  <localfile>
    <location>Microsoft-Windows-Sysmon/Operational</location>
    <log_format>eventchannel</log_format>
  </localfile>
  <localfile>
    <location>Microsoft-Windows-PowerShell/Operational</location>
    <log_format>eventchannel</log_format>
  </localfile>
</ossec_config>
